# Required for live chat
GROQ_API_KEY=

# Leave empty for localhost. For HTTPS deployment, use the exact public origin.
APP_ORIGIN=
DATABASE_PATH=data/edubot.sqlite3

# Groq models with JSON-schema support
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_TUTOR_MODEL=openai/gpt-oss-120b
GROQ_PRACTICE_MODEL=openai/gpt-oss-20b
GROQ_COACH_MODEL=openai/gpt-oss-120b
GROQ_REVIEW_MODEL=openai/gpt-oss-20b
GROQ_SAFETY_MODEL=openai/gpt-oss-20b
